# URL publica del despliegue, sin barra final.
NEXT_PUBLIC_SITE_URL=https://www.casa-atenta.com

# URL canónica del blog. Este dominio debe apuntar al mismo despliegue web.
NEXT_PUBLIC_BLOG_URL=https://blog.casa-atenta.com

# Domicilio fiscal/legal público del proveedor para el Libro de Reclamaciones.
NEXT_PUBLIC_LEGAL_ADDRESS=REPLACE_WITH_THE_LEGAL_ADDRESS

# Supabase: use una Secret key moderna (sb_secret_...).
# SUPABASE_SERVICE_ROLE_KEY queda solo como compatibilidad con proyectos antiguos.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=

# Resend: el remitente debe pertenecer a un dominio verificado.
RESEND_API_KEY=REPLACE_ME
RESEND_WEBHOOK_SECRET=REPLACE_ME
RESEND_FROM_EMAIL=Casa Atenta <notificaciones@casa-atenta.com>
CONTACT_INBOX=info@casa-atenta.com

# Cloudflare Turnstile: la site key es publica; la secret key nunca lo es.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_ME
TURNSTILE_SECRET_KEY=REPLACE_ME
TURNSTILE_ALLOWED_HOSTNAMES=casa-atenta.com,www.casa-atenta.com

# Secreto aleatorio de al menos 32 caracteres para anonimizar IPs al limitar abuso.
RATE_LIMIT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Secreto independiente para firmar confirmaciones y bajas. Rotarlo invalida enlaces ya enviados.
NEWSLETTER_TOKEN_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# Vercel lo envía como Bearer token al ejecutar tareas programadas.
CRON_SECRET=REPLACE_WITH_A_THIRD_LONG_RANDOM_SECRET

# -----------------------------------------------------------------------------
# Tienda independiente: tienda.casa-atenta.com
# Mantener NEXT_PUBLIC_STORE_MODE y STORE_MODE en preview hasta que catálogo,
# stock, políticas y credenciales hayan sido aprobados para producción.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STORE_URL=https://tienda.casa-atenta.com
NEXT_PUBLIC_MARKETING_URL=https://www.casa-atenta.com
NEXT_PUBLIC_STORE_MODE=preview
STORE_MODE=preview
NEXT_PUBLIC_STORE_PHONE=+51 999 999 999
NEXT_PUBLIC_STORE_EMAIL=tienda@casa-atenta.com
NEXT_PUBLIC_STORE_WHATSAPP=https://wa.me/51999999999
NEXT_PUBLIC_STORE_DELIVERY_WINDOW=REPLACE_WITH_APPROVED_DELIVERY_WINDOW

# Supabase del storefront. La publishable key puede llegar al navegador;
# la Secret key nunca debe usar el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Google OAuth para Supabase Auth local. En producción se configura también en
# el panel de Supabase y en Google Cloud con el callback del proyecto.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# Openpay Perú. La public key se usa únicamente para tokenizar en el navegador;
# la private key y credenciales del webhook son secretos de servidor.
NEXT_PUBLIC_OPENPAY_MERCHANT_ID=REPLACE_WITH_OPENPAY_MERCHANT_ID
NEXT_PUBLIC_OPENPAY_PUBLIC_KEY=pk_REPLACE_ME
NEXT_PUBLIC_OPENPAY_ENVIRONMENT=sandbox
OPENPAY_MERCHANT_ID=REPLACE_WITH_OPENPAY_MERCHANT_ID
OPENPAY_PRIVATE_KEY=sk_REPLACE_ME
OPENPAY_ENVIRONMENT=sandbox
OPENPAY_USE_3DS=true
OPENPAY_WEBHOOK_USERNAME=REPLACE_WITH_RANDOM_USERNAME
OPENPAY_WEBHOOK_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# Correos transaccionales. Verificar el dominio/remitente antes de activar ventas.
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=Casa Atenta Tienda <pedidos@casa-atenta.com>
STORE_NOTIFICATION_REPLY_TO=tienda@casa-atenta.com
