# URL publica del despliegue, sin barra final.
NEXT_PUBLIC_SITE_URL=https://www.casa-atenta.com

# Domicilio fiscal/legal público del proveedor para el Libro de Reclamaciones.
NEXT_PUBLIC_LEGAL_ADDRESS=REPLACE_WITH_THE_LEGAL_ADDRESS

# Supabase: use una Secret key moderna (sb_secret_...).
# SUPABASE_SERVICE_ROLE_KEY queda solo como compatibilidad con proyectos antiguos.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=

# Resend: el remitente debe pertenecer a un dominio verificado.
RESEND_API_KEY=REPLACE_ME
RESEND_WEBHOOK_SECRET=REPLACE_ME
RESEND_FROM_EMAIL=Casa Atenta <notificaciones@casa-atenta.com>
CONTACT_INBOX=info@casa-atenta.com

# Cloudflare Turnstile: la site key es publica; la secret key nunca lo es.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_ME
TURNSTILE_SECRET_KEY=REPLACE_ME
TURNSTILE_ALLOWED_HOSTNAMES=casa-atenta.com,www.casa-atenta.com

# Secreto aleatorio de al menos 32 caracteres para anonimizar IPs al limitar abuso.
RATE_LIMIT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Secreto independiente para firmar confirmaciones y bajas. Rotarlo invalida enlaces ya enviados.
NEWSLETTER_TOKEN_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# Vercel lo envía como Bearer token al ejecutar tareas programadas.
CRON_SECRET=REPLACE_WITH_A_THIRD_LONG_RANDOM_SECRET
