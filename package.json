{
  "name": "casaatenta-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/storefront"
  ],
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "store:dev": "npm --workspace @casa-atenta/storefront run dev",
    "store:build": "npm --workspace @casa-atenta/storefront run build",
    "store:lint": "npm --workspace @casa-atenta/storefront run lint",
    "store:typecheck": "npm --workspace @casa-atenta/storefront run typecheck",
    "check:all": "npm run lint && npm run build && npm run store:lint && npm run store:typecheck && npm run store:build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.16.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "6.17.2",
    "server-only": "0.0.1",
    "split-type": "^0.3.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
